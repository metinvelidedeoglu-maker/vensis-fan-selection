<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(index|fan-selection|catalog|projects|project|customers|custom-products|quotation|order|project-print|detail)\.html$" vensis_noindex=1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=vensis_noindex

  <FilesMatch "\.(html?|js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
