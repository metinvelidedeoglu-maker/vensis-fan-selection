<IfModule mod_rewrite.c>
  RewriteEngine On

  # Clean public fan routes. The browser keeps the SEO path while Apache serves
  # the existing catalog application underneath it.
  #   /tr/fan/vitlo/crs/
  #   /en/fan/soler-palau/<series>/
  #   /tr/fan/vortice/<series>/<model>/
  RewriteRule ^(tr|en)/fan/vortice/?$ catalog-vortice-stable.html [L,QSA]
  RewriteRule ^(tr|en)/fan/vortice/[^/]+(?:/[^/]+)?/?$ catalog-vortice.html [L,QSA]
  RewriteRule ^(tr|en)/fan/(vitlo|soler-palau)(?:/.*)?$ catalog-brand.html [L,QSA]

  # Locale URL trees share the same physical application files. The browser keeps
  # /tr/... or /en/... while Apache serves the existing file underneath it.
  # Query parameters remain supported as backward-compatible legacy routes.
  RewriteRule ^(tr|en)/(.*)$ $2 [L,QSA]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(tr/|en/)?(index|fan-selection|catalog|projects|project|customers|custom-products|quotation|order|project-print|detail)\.html$" vensis_noindex=1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=vensis_noindex

  <FilesMatch "\.(html?|js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
